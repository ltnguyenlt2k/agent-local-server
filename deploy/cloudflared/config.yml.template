# Template for cloudflared/config.yml — DO NOT edit config.yml directly,
# it is generated (and gitignored). Edit this template, then re-run:
#   ./scripts/cloudflare-setup.sh <tunnel-name> <hostname>
# (it renders this automatically after creating/updating the tunnel.)
#
# Why a locally-managed (config-file) tunnel instead of the simpler
# --token remotely-managed mode: configuring the hostname->service
# mapping ("Public Hostname") for a --token tunnel requires the
# Cloudflare Zero Trust dashboard, which as of this writing gates
# access behind an "Activate Zero Trust" step that asks for a payment
# method on file even for the $0/month Free tier. That's a real
# adoption blocker for a lot of people. The locally-managed approach
# below sets the same hostname->service mapping in a file instead,
# using the credentials cloudflared already saved when the tunnel was
# created — no Zero Trust activation, no payment method, ever.

tunnel: ${CLOUDFLARE_TUNNEL_ID}
credentials-file: /etc/cloudflared/tunnel-credentials.json

ingress:
  - hostname: ${PUBLIC_HOSTNAME}
    service: http://litellm:4000
  # Catch-all — required by cloudflared; anything not matched above
  # (there's only one hostname here, but this is mandatory syntax).
  - service: http_status:404
