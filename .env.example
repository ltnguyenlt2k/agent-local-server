# ============================================================
# local-ai-gateway environment template
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is gitignored — never commit it. Generate secrets with:
#   openssl rand -hex 32
# ============================================================

# ============================================================
# LiteLLM
# ============================================================

# Admin credential for the LiteLLM Proxy. Only used internally
# (bootstrap/preflight/key-management scripts) — never hand this to
# an external client ("App A"). Must start with "sk-".
LITELLM_MASTER_KEY=sk-change-me

# Encrypts provider credentials stored in Postgres. Generate once and
# NEVER change after the database has stored encrypted credentials —
# rotating it after the fact breaks decryption of existing data.
LITELLM_SALT_KEY=sk-change-me-with-another-random-secret

# NOTE: 4000 is a common default and easily collides with something else
# already running on machine B (verify with `ss -ltn | grep :4000` before
# first deploy — an unrelated project's dev server, another gateway,
# etc). Change this if it's already taken; nothing else in this repo
# hardcodes 4000, everything reads LITELLM_PORT.
LITELLM_PORT=4000

# Pinned image — verify this is still current/safe before first deploy:
# https://github.com/BerriAI/litellm/releases
# (Do not use v1.82.7 or v1.82.8 — pulled after a March 2026 supply-chain
# incident; the clean release is v1.83.0 and later.)
LITELLM_IMAGE=ghcr.io/berriai/litellm-database:v1.90.2

# ============================================================
# PostgreSQL
# ============================================================

POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me

# Major-version pin is intentional: Postgres minor releases are
# bugfix-only and share the on-disk format, so this stays reproducible
# without needing to bump a point release manually.
POSTGRES_IMAGE=postgres:16

# Must match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above and the
# in-compose service name ("postgres").
DATABASE_URL=postgresql://litellm:change-me@postgres:5432/litellm

# ============================================================
# Ollama native host (runs OUTSIDE Docker Compose, on machine B)
# ============================================================

# Default assumes Ollama installed natively on Windows, with Docker
# Desktop's WSL integration providing host.docker.internal resolution
# inside containers (see docs/ollama-windows.md, Phương án A).
#
# If instead you run Ollama natively inside WSL (docs/ollama-wsl.md,
# Phương án B), this usually still needs to be host.docker.internal
# resolved via `extra_hosts: host-gateway` in docker-compose.yml —
# verify with `./scripts/preflight.sh` rather than assuming.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# The name actually installed in Ollama (`ollama list`), e.g. qwen2.5.
#
# IMPORTANT if App A does tool/function calling: Ollama's runtime
# context (num_ctx) defaults to 4096 tokens regardless of what this
# model supports, and silently truncates input past that — no error,
# just an empty/broken response once system prompt + tool schemas +
# conversation exceed it. This is set on the Ollama side (OLLAMA_
# CONTEXT_LENGTH env var on machine B), not here — see the "Context
# length" section in docs/ollama-windows.md / docs/ollama-wsl.md
# before wiring up any agent with more than a couple of tools.
OLLAMA_MODEL=<your-model-name>

# Public alias exposed by LiteLLM. App A only ever sees this name —
# never the real OLLAMA_MODEL.
LITELLM_MODEL_ALIAS=local-agent

# Optional override: only set this if the URL your WSL shell can reach
# Ollama at differs from OLLAMA_BASE_URL (the URL the litellm CONTAINER
# reaches Ollama at). Used by scripts/preflight.sh for the host-side
# reachability check. Leave blank to just reuse OLLAMA_BASE_URL.
OLLAMA_HOST_TEST_URL=

# ============================================================
# Cloudflare
# ============================================================

# Default: locally-managed tunnel (config-file based). Set by
# ./scripts/cloudflare-setup.sh automatically. Avoids the Cloudflare
# Zero Trust dashboard entirely, which as of this writing requires
# "activating" Zero Trust (payment method on file, even for the free
# tier) just to configure a tunnel's hostname->service mapping via the
# dashboard's Public Hostname UI. This mode configures that mapping in
# cloudflared/config.yml.template instead — see that file for why.
CLOUDFLARE_TUNNEL_ID=

# Legacy/alternative: remotely-managed tunnel token from the Cloudflare
# dashboard (Networking / Tunnels / Create Tunnel / Cloudflared). Only
# used if you deliberately switch docker-compose.yml's cloudflared
# command back to --token mode (e.g. you've already activated Zero
# Trust and prefer configuring Public Hostname via the dashboard).
# Never commit either variable.
CLOUDFLARE_TUNNEL_TOKEN=

# Pinned image — verify current tag before first deploy:
# https://hub.docker.com/r/cloudflare/cloudflared/tags
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.8.2

# The public hostname clients use. Also used to render
# cloudflared/config.yml's ingress rule — must match what
# ./scripts/cloudflare-setup.sh routed the tunnel to.
PUBLIC_AI_BASE_URL=https://ai.example.com

# ============================================================
# Ops (optional)
# ============================================================

# If set, scripts/status.sh POSTs a short JSON summary here whenever a
# check fails (Slack/Discord/Telegram incoming webhook URL, etc).
# Leave blank to disable — status.sh will not error if this is empty.
ALERT_WEBHOOK_URL=
