# Secrets — never commit real environment values.
.env
.env.*
!.env.example

# Generated at bootstrap time by scripts/render-config.sh — only the
# .template source is tracked in git.
litellm/config.yaml

# Generated by scripts/cloudflare-setup.sh — config.yaml is a rendered
# template, tunnel-credentials.json is a copy of a real Cloudflare
# tunnel secret. Only cloudflared/config.yml.template is tracked.
cloudflared/config.yml
cloudflared/tunnel-credentials.json

# Database dumps / backups.
backups/*.sql
backups/*.dump

# Logs (wsl-autostart.sh, ad-hoc script output, docker log redirects, etc).
*.log
logs/*.log

# Local editor/OS noise.
.DS_Store

# Root planning/spec document — kept local only, not published to this repo.
local-ai-gateway-implementation-plan-v3-reviewed.md
